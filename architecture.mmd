flowchart LR
  subgraph A[Offline model-development pipeline]
    D[Open Fashion-MNIST dataset\n60,000 train + 10,000 test images]
    P[Validate, normalize pixels\nflatten each 28x28 image]
    T[Train + evaluate classifier\naccuracy, precision, recall, F1]
    M[(Serialized model artifact\n.joblib)]
    D --> P --> T --> M
  end
  subgraph B[Nightly inference pipeline]
    S[(Image storage\ndata/incoming)]
    C[Windows Task Scheduler\n02:00 daily]
    BP[Batch client\nread new images + Base64 JSON]
    API[Flask REST API\nPOST /predict/batch]
    MOD[Loaded classifier\npredict_proba]
    OUT[(Prediction CSV\noutputs/)]
    PROC[(Processed archive\ndata/processed/date)]
    LOG[Logs + health checks\nlogs/]
    S --> BP
    C --> BP
    BP --> API --> MOD --> API --> OUT
    OUT --> PROC
    BP -. errors/status .-> LOG
    API -. request timing/errors .-> LOG
  end
  M --> MOD
